import Verifier
import Verifier.Pretty

open NearAsync NearAsync.Deposit

structure Opts where
  model : String := ""
  depth : Nat := 10
  adversary : Adversary := .attackerCode
  emitLean : Option String := none

def parseArgs : List String → Opts → Except String Opts
  | [], o => .ok o
  | "--depth" :: n :: rest, o => match n.toNat? with
    | some d => parseArgs rest { o with depth := d }
    | none => .error s!"bad depth {n}"
  | "--adversary" :: "attacker" :: rest, o => parseArgs rest { o with adversary := .attackerCode }
  | "--adversary" :: "any" :: rest, o => parseArgs rest { o with adversary := .anyReceipt }
  | "--emit-lean" :: f :: rest, o => parseArgs rest { o with emitLean := some f }
  | m :: rest, o => if o.model = "" then parseArgs rest { o with model := m } else .error s!"unexpected {m}"

def usage : String :=
  "usage: exorcist check <deposit-vulnerable|deposit-fixed> [--depth N] [--adversary attacker|any] [--emit-lean FILE]"

def witnessSource (model : String) (v : Version) (adv : Adversary) (t : List (Step Acct (Call Acct))) : String :=
  let vs := match v with | .vulnerable => ".vulnerable" | .fixed => ".fixed"
  let as := match adv with | .attackerCode => ".attackerCode" | .anyReceipt => ".anyReceipt"
  let steps := ",\n    ".intercalate (t.map stepLean)
  s!"import Verifier.Models.Deposit\n\n" ++
  s!"/-! Generated by `exorcist check {model}`: a concrete violating trace, checked by the kernel. -/\n\n" ++
  s!"namespace NearAsync.Deposit\nopen NearAsync\n\n" ++
  s!"def foundTrace : List (Step Acct (Call Acct)) :=\n  [ {steps} ]\n\n" ++
  s!"theorem found_trace_violates_solvency :\n" ++
  s!"    ((run (system {vs} {as}) init foundTrace).map solvent) = some false := by decide\n\n" ++
  s!"end NearAsync.Deposit\n"

def check (o : Opts) : IO UInt32 := do
  let v ← match o.model with
    | "deposit-vulnerable" => pure Version.vulnerable
    | "deposit-fixed" => pure Version.fixed
    | m => do IO.eprintln s!"unknown model {m}\n{usage}"; return 2
  let sys := system v o.adversary
  let sc : Scenario St Acct (Call Acct) := { sys, init, menu, ok := solvent }
  let advS := match o.adversary with
    | .attackerCode => "only attacker-owned contracts may fail"
    | .anyReceipt => "any receipt may fail"
  IO.println s!"model: {o.model}   invariant: Σ ledger ≤ tokens held by vault   adversary: {advS}"
  IO.println s!"initial: {snapshot init}"
  let r := explore sc o.depth
  match r.trace with
  | none =>
    IO.println s!"\nNO VIOLATION — bounded to depth {o.depth} ({r.visited} states explored, all orderings and failure outcomes)."
    IO.println "This is a bounded result, not a proof for all traces."
    return 0
  | some t =>
    IO.println s!"\nVIOLATION found at depth {r.depth} ({r.visited} states explored). Shortest attack trace:\n"
    for line in renderTrace sys init t do IO.println line
    let src := witnessSource o.model v o.adversary t
    match o.emitLean with
    | some f =>
      IO.FS.writeFile f src
      IO.println s!"\nWitness theorem written to {f} (check it with: lake env lean {f})"
    | none => IO.println s!"\nWitness theorem (re-checked by the Lean kernel with `decide`):\n\n{src}"
    return 1

def main (args : List String) : IO UInt32 := do
  match args with
  | "check" :: rest =>
    match parseArgs rest {} with
    | .ok o => check o
    | .error e => do IO.eprintln s!"{e}\n{usage}"; return 2
  | _ => do IO.eprintln usage; return 2

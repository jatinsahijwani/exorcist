{
  "name": "exorcist-site",
  "private": true,
  "description": "Exorcist's GitHub Pages site: the results page and the trace viewer. Static export, separate from the Lean/Rust build.",
  "scripts": {
    "media": "mkdir -p public/media && cp ../docs/media/demo.svg ../docs/media/agent-gate.svg public/media/",
    "dev": "npm run media && next dev",
    "build": "npm run media && next build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

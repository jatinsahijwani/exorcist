[0.5, "o", "\u001b[2J\u001b[H$ exorcist check incident-2026-10\r\n"]
[2.31, "o", "NOTE:       a minimal model of the mechanism in the NEAR Intents postmortem (Oct 2026), written from scratch \u2014 NOT their contract\r\n"]
[2.43, "o", "RESULT: VIOLATION (attacker_profit) at depth 8, 26191 states explored in 100 ms. Shortest attack trace:\r\n"]
[2.55, "o", "1. eve sends tx: token.ft_transfer_call(vault, 100, \"notify hook\") (+1 yocto)\r\n"]
[2.67, "o", "     ledger: alice=300 eve=0 (total 300) | tokens: vault=300 alice=0 eve=100\r\n"]
[2.79, "o", "2. run #0 token.ft_transfer_call(vault, 100, \"notify hook\")  \u21d2 returns a promise\r\n"]
[2.91, "o", "     ledger: alice=300 eve=0 (total 300) | tokens: vault=400 alice=0 eve=0\r\n"]
[3.03, "o", "3. run #1 vault.ft_on_transfer(eve, 100, \"notify hook\")  \u21d2 returns a promise\r\n"]
[3.15, "o", "     ledger: alice=300 eve=100 (total 400) | tokens: vault=400 alice=0 eve=0\r\n"]
[3.27, "o", "4. FAIL #3 hook.on_deposit(eve, 100)  \u21d2 adversary makes it fail\r\n"]
[3.39, "o", "     ledger: alice=300 eve=100 (total 400) | tokens: vault=400 alice=0 eve=0\r\n"]
[3.51, "o", "5. run #2 token.ft_resolve_transfer(eve, vault, 100)  \u21d2 ok, returns 0  \u2014 refunds 100 vault \u2192 eve\r\n"]
[3.63, "o", "     ledger: alice=300 eve=100 (total 400) | tokens: vault=300 alice=0 eve=100   \u26a0 INSOLVENT (ledger > tokens held)\r\n"]
[3.75, "o", "6. eve sends tx: vault.withdraw(100)\r\n"]
[3.87, "o", "     ledger: alice=300 eve=100 (total 400) | tokens: vault=300 alice=0 eve=100   \u26a0 INSOLVENT (ledger > tokens held)\r\n"]
[3.99, "o", "7. run #5 vault.withdraw(100)  \u21d2 ok (no value)\r\n"]
[4.11, "o", "     ledger: alice=300 eve=0 (total 300) | tokens: vault=300 alice=0 eve=100\r\n"]
[4.23, "o", "8. run #6 token.ft_transfer(eve, 100)  \u21d2 ok (no value)\r\n"]
[4.35, "o", "     ledger: alice=300 eve=0 (total 300) | tokens: vault=200 alice=0 eve=200   \u26a0 INSOLVENT (ledger > tokens held)\r\n"]
[4.47, "o", "\r\n"]
[4.59, "o", "  \u2713 checked by the Lean kernel (decide): this trace really violates the property\r\n"]
[7.71, "o", "\u001b[2J\u001b[H$ exorcist prove incident-2026-10-fixed\r\n"]
